# OpenAI Responses API — ИИ-провайдер продукта
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5            # разбор заявок и агент правок
OPENAI_MODEL_FAST=gpt-5.4-mini  # короткие пояснения к плану
# Если api.openai.com недоступен из сети сервера — адрес своего шлюза/прокси (совместимый с OpenAI API)
OPENAI_BASE_URL=

# Геокодирование: с ключом — Яндекс, без ключа — Nominatim (OSM, медленнее и хуже по МО)
YANDEX_GEOCODER_KEY=
OSRM_URL=https://router.project-osrm.org
TRAFFIC_FACTOR=1.5              # OSRM не знает пробок — умножаем время в пути
SOLVER_TIME_LIMIT=3             # секунд на один вариант расстановки водитель→машина

# После MVP
PUBLIC_URL=http://localhost:8000
BITRIX_WEBHOOK=                 # https://<портал>.bitrix24.ru/rest/<user>/<token>/
IMPORT_TOKEN=                   # токен, с которым 1С шлёт заявки на /api/import/1c/{day}
